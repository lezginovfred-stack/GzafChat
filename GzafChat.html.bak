
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GzafChat — Кастомизация, Анимации, Звонки и Авторизация</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Обеспечиваем фиксацию высоты по динамическому вьюпорту, исключая обрезку панелей */
        html, body {
            height: 100vh;
            height: 100dvh;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        #messagesContainer {
            transition: background-color 0.3s ease;
        }
        
        /* Кастомный скроллбар */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* АНИМАЦИЯ НАЖАТИЯ И НАВЕДЕНИЯ ДЛЯ КНОПОК */
        .btn-anim {
            transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            transform: scale(1);
        }
        .btn-anim:hover {
            transform: scale(1.05);
            filter: brightness(1.15);
        }
        .btn-anim:active {
            transform: scale(0.95);
            filter: brightness(0.95);
        }

        /* Анимация для новых сообщений */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
        .message-new-anim {
            animation: fadeInUp 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* ГЛАДКАЯ КРУГОВАЯ ПУЛЬСАЦИЯ */
        @keyframes statusRipple {
            0% {
                transform: scale(0.8);
                opacity: 0.8;
            }
            100% {
                transform: scale(2.4);
                opacity: 0;
            }
        }

        /* ЗЕЛЕНЫЙ ИНДИКАТОР ОНЛАЙН С АНИМАЦИЕЙ */
        .status-online-dot {
            background-color: #10b981; /* emerald-500 */
            position: relative;
        }
        .status-online-dot::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: inherit;
            border-radius: inherit;
            animation: statusRipple 1.6s cubic-bezier(0.24, 0, 0.38, 1) infinite;
        }

        /* КРАСНЫЙ ИНДИКАТОР ОФЛАЙН С АНИМАЦИЕЙ */
        .status-offline-dot {
            background-color: #f43f5e; /* rose-500 */
            position: relative;
        }
        .status-offline-dot::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: inherit;
            border-radius: inherit;
            animation: statusRipple 2s cubic-bezier(0.24, 0, 0.38, 1) infinite;
        }

        /* КОМПАКТНЫЙ РЕЖИМ ПЕРЕПИСКИ */
        body.compact-mode .py-2.px-3\.5 {
            padding-top: 0.25rem !important;
            padding-bottom: 0.25rem !important;
            padding-left: 0.65rem !important;
            padding-right: 0.65rem !important;
        }
        body.compact-mode .message-new-anim {
            margin-top: 0.35rem !important;
            margin-bottom: 0.35rem !important;
        }
        body.compact-mode #messagesContainer > div {
            margin-top: 0.35rem !important;
            margin-bottom: 0.35rem !important;
        }

        /* СТИЛИ ДЛЯ СВЕТЛОЙ ТЕМЫ ОФОРМЛЕНИЯ */
        body.light-theme {
            background-color: #f8fafc;
            color: #0f172a;
        }
        body.light-theme #appMainContainer {
            background-color: rgba(255, 255, 255, 0.85);
            border-color: #cbd5e1;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
        }
        body.light-theme aside {
            border-color: #cbd5e1;
            background-color: rgba(248, 250, 252, 0.5);
        }
        body.light-theme #activeChat {
            background-color: #f8fafc;
        }
        body.light-theme #noChatSelected {
            background-color: #f1f5f9;
        }
        body.light-theme .bg-slate-900\/50 {
            background-color: rgba(241, 245, 249, 0.85);
        }
        body.light-theme .border-slate-800 {
            border-color: #cbd5e1;
        }
        body.light-theme .bg-slate-950 {
            background-color: #f1f5f9;
            border-color: #cbd5e1;
        }
        body.light-theme .text-slate-400 {
            color: #475569;
        }
        body.light-theme .text-slate-200 {
            color: #0f172a;
        }
        body.light-theme .text-slate-500 {
            color: #64748b;
        }
        body.light-theme input {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }
        body.light-theme input::placeholder {
            color: #94a3b8 !important;
        }
        body.light-theme .bg-slate-900 {
            background-color: #ffffff;
            border-color: #cbd5e1;
            color: #0f172a;
        }
        body.light-theme #groupMembersList {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }
        body.light-theme #messagesContainer {
            background-color: #f1f5f9 !important;
        }
        body.light-theme #settingsModal > div,
        body.light-theme #profileInfoModal > div,
        body.light-theme #groupModal > div,
        body.light-theme #customAlert > div,
        body.light-theme #phoneContactsModal > div {
            background-color: #ffffff;
            border-color: #cbd5e1;
            color: #0f172a;
        }
        body.light-theme .text-slate-300 {
            color: #1e293b;
        }
        body.light-theme .bg-slate-950\/40 {
            background-color: #f8fafc;
        }
        body.light-theme select {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

        body.light-theme #tabContent-statuses,
        body.light-theme #tabContent-calls {
            background-color: #f1f5f9;
        }
        body.light-theme #tabContent-statuses .bg-slate-950\/40,
        body.light-theme #tabContent-calls .bg-slate-900\/40 {
            background-color: #ffffff;
            border-color: #cbd5e1;
        }

        /* ПЛАСТИКОВЫЙ СТИЛЬ FAB КНОПКИ (СИНИЙ С ГЛЯНЦЕМ) */
        .plastic-btn {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.45) 0%, rgba(79, 70, 229, 0.2) 100%);
            box-shadow: 
                0 10px 25px 0 rgba(0, 0, 0, 0.4),
                inset 0 2px 4px rgba(255, 255, 255, 0.3),
                inset 0 -3px 8px rgba(0, 0, 0, 0.35),
                0 0 0 1px rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-radius: 50%;
            transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        }
        .plastic-btn:hover {
            transform: scale(1.08) translateY(-2px);
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.65) 0%, rgba(79, 70, 229, 0.3) 100%);
            box-shadow: 
                0 14px 35px 0 rgba(99, 102, 241, 0.45),
                inset 0 2px 6px rgba(255, 255, 255, 0.45),
                inset 0 -4px 10px rgba(0, 0, 0, 0.45);
        }
        .plastic-btn:active {
            transform: scale(0.95);
            box-shadow: 
                0 4px 10px 0 rgba(0, 0, 0, 0.5),
                inset 0 1px 3px rgba(255, 255, 255, 0.2),
                inset 0 -2px 5px rgba(0, 0, 0, 0.5);
        }

        body.light-theme .plastic-btn {
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.5) 0%, rgba(79, 70, 229, 0.25) 100%);
            box-shadow: 
                0 8px 24px 0 rgba(99, 102, 241, 0.25),
                inset 0 2px 4px rgba(255, 255, 255, 0.65),
                inset 0 -3px 8px rgba(0, 0, 0, 0.1),
                0 0 0 1px rgba(99, 102, 241, 0.15);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans h-full w-screen flex justify-center items-center overflow-hidden animate-none">

    <!-- КРАСИВОЕ КАСТОМНОЕ ОКНО УВЕДОМЛЕНИЯ -->
    <div id="customAlert" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[300] flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-sm p-6 text-center shadow-2xl animate-in zoom-in-95 duration-200">
            <div class="w-16 h-16 rounded-full bg-emerald-500/15 flex items-center justify-center text-emerald-500 mx-auto mb-4 animate-bounce">
                <i data-lucide="check-circle" class="w-10 h-10"></i>
            </div>
            <h3 id="customAlertTitle" class="text-lg font-bold text-slate-100" data-i18n="successAlertTitle">Успешно!</h3>
            <p id="customAlertMsg" class="text-sm text-slate-400 mt-2 leading-relaxed">Операция успешно выполнена.</p>
            <button onclick="closeCustomAlert()" class="w-full mt-6 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl transition btn-anim text-sm" data-i18n="alertOkBtn">
                Отлично
            </button>
        </div>
    </div>

    <!-- СКРЫТЫЙ ИНПУТ ДЛЯ ЗАГРУЗКИ АВАТАРА КЛИКОМ ПО ПРОФИЛЮ -->
    <input type="file" id="directAvatarInput" accept="image/*" class="hidden" onchange="handleDirectAvatarUpload(event)">

    <!-- СИСТЕМА ВХОДА, РЕГИСТРАЦИИ И ВОССТАНОВЛЕНИЯ -->
    <div id="authContainer" class="fixed inset-0 bg-slate-950 z-[200] flex flex-col items-center justify-center p-4">
        <!-- Кнопки выбора языка на экране авторизации -->
        <div class="flex justify-end space-x-3 text-xs text-slate-400 mb-4 w-full max-w-md px-2">
            <button type="button" onclick="setLanguage('ru')" class="hover:text-indigo-400 transition font-semibold">RU</button>
            <button type="button" onclick="setLanguage('az')" class="hover:text-indigo-400 transition font-semibold">AZ</button>
            <button type="button" onclick="setLanguage('en')" class="hover:text-indigo-400 transition font-semibold">EN</button>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-6">
            <div class="text-center">
                <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 flex items-center justify-center text-indigo-500 mx-auto mb-3">
                    <i data-lucide="message-square" class="w-8 h-8"></i>
                </div>
                <h2 id="authTitle" class="text-2xl font-bold tracking-tight" data-i18n="authTitle">Вход в GzafChat</h2>
                <p id="authSubtitle" class="text-sm text-slate-400 mt-1" data-i18n="authSubtitle">Введите ваши данные для доступа к переписке</p>
            </div>

            <!-- ФОРМА ВХОДА -->
            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="usernameLabel">Имя пользователя (Никнейм)</label>
                    <input type="text" id="loginUsername" required placeholder="например, admin" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2.5 px-4 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs text-slate-400 font-semibold uppercase" data-i18n="passwordLabel">Пароль</label>
                        <button type="button" onclick="switchAuthMode('forgot')" class="text-xs text-indigo-400 hover:underline font-semibold" data-i18n="forgotPasswordLink">Забыли пароль?</button>
                    </div>
                    <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2.5 px-4 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold transition shadow-lg btn-anim text-sm" data-i18n="loginBtn">
                    Войти в аккаунт
                </button>
                <p class="text-center text-xs text-slate-400 mt-2">
                    <span data-i18n="noAccount">Нет аккаунта?</span> <button type="button" onclick="switchAuthMode('register')" class="text-indigo-400 hover:underline font-semibold" data-i18n="registerLink">Зарегистрироваться</button>
                </p>
            </form>

            <!-- ФОРМА РЕГИСТРАЦИИ (Без загрузки фото) -->
            <form id="registerForm" onsubmit="handleRegister(event)" class="space-y-4 hidden max-h-[70vh] overflow-y-auto pr-1">
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="regUsernameLabel">Имя пользователя (Уникальный ник)</label>
                    <input type="text" id="regUsername" required placeholder="User123" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="regDisplayNameLabel">Отображаемое имя</label>
                    <input type="text" id="regDisplayName" required placeholder="Константин" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="regPasswordLabel">Пароль</label>
                    <input type="password" id="regPassword" required placeholder="Минимум 4 символа" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase text-[10px]" data-i18n="regPhoneLabel">Номер телефона</label>
                        <input type="text" id="regPhone" placeholder="+7 (999) 000-00-00" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase text-[10px]" data-i18n="regBioLabel">О себе</label>
                        <input type="text" id="regBio" placeholder="Статус профиля" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                    </div>
                </div>
                <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl font-bold transition shadow-lg btn-anim text-sm" data-i18n="createAccountBtn">
                    Создать аккаунт
                </button>
                <p class="text-center text-xs text-slate-400 mt-2">
                    <span data-i18n="alreadyHaveAccount">Уже есть аккаунт?</span> <button type="button" onclick="switchAuthMode('login')" class="text-indigo-400 hover:underline font-semibold" data-i18n="loginLink">Войти</button>
                </p>
            </form>

            <!-- ФОРМА ВОССТАНОВЛЕНИЯ ПАРОЛЯ -->
            <form id="forgotForm" onsubmit="handleForgotPassword(event)" class="space-y-4 hidden max-h-[70vh] overflow-y-auto pr-1">
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="forgotUsernameLabel">Имя пользователя (Никнейм)</label>
                    <input type="text" id="forgotUsername" required placeholder="например, admin" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="forgotPhoneLabel">Номер телефона</label>
                    <input type="text" id="forgotPhone" required placeholder="+7 (999) 000-00-00" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div>
                    <label class="block text-xs text-slate-400 mb-1 font-semibold uppercase" data-i18n="forgotNewPasswordLabel">Новый пароль</label>
                    <input type="password" id="forgotNewPassword" required placeholder="Минимум 4 символа" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-bold transition shadow-lg btn-anim text-sm" data-i18n="forgotBtn">
                    Сбросить и установить новый пароль
                </button>
                <p class="text-center text-xs text-slate-400 mt-2">
                    <button type="button" onclick="switchAuthMode('login')" class="text-indigo-400 hover:underline font-semibold" data-i18n="backToLoginLink">Вернуться ко входу</button>
                </p>
            </form>
        </div>
    </div>


    <!-- ГЛАВНЫЙ КОНТЕЙНЕР ПРИЛОЖЕНИЯ -->
    <div id="appMainContainer" class="w-full h-full md:h-[92vh] md:w-[95%] max-w-7xl md:rounded-2xl md:shadow-2xl md:border md:border-slate-800 flex overflow-hidden bg-slate-900/80 backdrop-blur-xl hidden">
        
        <!-- ЛЕВАЯ ПАНЕЛЬ: СПИСОК ЧАТОВ (С ТАБАМИ WHATSAPP) -->
        <aside class="w-full md:w-[380px] h-full flex flex-col border-r border-slate-800 flex-shrink-0 relative" id="sidebar">
            <!-- Шапка профиля -->
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
                <div class="flex items-center space-x-3 overflow-hidden">
                    <img id="myProfileAvatar" src="" onclick="openProfileInfo(event, 'me')" class="w-10 h-10 rounded-full object-cover ring-2 ring-indigo-500 flex-shrink-0 cursor-pointer hover:opacity-80 transition" alt="My Profile">
                    <div class="overflow-hidden">
                        <h2 id="myProfileName" class="font-semibold text-sm truncate">Пользователь</h2>
                        <span id="myProfileStatusLabel" class="text-[10px] text-emerald-400 flex items-center gap-1">
                            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full status-ripple"></span> <span data-i18n="onlineStatus">в сети</span>
                        </span>
                    </div>
                </div>
                <div class="flex space-x-1 text-slate-400">
                    <!-- КНОПКА СОЗДАНИЯ ГРУППЫ -->
                    <button onclick="toggleGroupModal()" class="p-2 hover:bg-slate-800 rounded-full transition text-indigo-400 hover:text-indigo-300 btn-anim" title="Создать группу"><i data-lucide="users" class="w-5 h-5"></i></button>
                    <!-- Кнопка настроек -->
                    <button class="p-2 hover:bg-slate-800 rounded-full transition text-indigo-400 hover:text-indigo-300 btn-anim" onclick="toggleSettingsModal()"><i data-lucide="settings" class="w-5 h-5"></i></button>
                </div>
            </div>

            <!-- ВЕРХНЯЯ ПАНЕЛЬ ТАБОВ (ИКОНКИ В СТИЛЕ WHATSAPP) -->
            <div class="flex border-b border-slate-800 bg-slate-900/20 text-slate-400 flex-shrink-0">
                <button onclick="switchTab('chats')" id="tabBtn-chats" class="flex-1 py-3 flex justify-center items-center text-indigo-500 border-b-2 border-indigo-500 transition btn-anim" title="Чаты" data-i18n="tabChatsTooltip">
                    <i data-lucide="message-square" class="w-5 h-5"></i>
                </button>
                <button onclick="switchTab('statuses')" id="tabBtn-statuses" class="flex-1 py-3 flex justify-center items-center border-b-2 border-transparent hover:text-slate-200 transition btn-anim" title="Статусы" data-i18n="tabStatusesTooltip">
                    <i data-lucide="aperture" class="w-5 h-5"></i>
                </button>
                <button onclick="switchTab('calls')" id="tabBtn-calls" class="flex-1 py-3 flex justify-center items-center border-b-2 border-transparent hover:text-slate-200 transition btn-anim" title="Звонки" data-i18n="tabCallsTooltip">
                    <i data-lucide="phone" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- СОДЕРЖИМОЕ ТАБОВ -->
            
            <!-- ТАБ: ЧАТЫ -->
            <div id="tabContent-chats" class="flex-1 flex flex-col overflow-hidden">
                <!-- Поиск -->
                <div class="p-3 flex-shrink-0">
                    <div class="relative">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-3"></i>
                        <input type="text" id="searchInput" oninput="filterChats()" placeholder="Поиск контактов..." class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 pl-10 pr-4 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition">
                    </div>
                </div>

                <!-- Список контактов -->
                <div class="flex-1 overflow-y-auto divide-y divide-slate-800/50" id="chatsContainer">
                    <!-- Сюда динамически рендерятся чаты -->
                </div>
            </div>

            <!-- ТАБ: СТАТУСЫ -->
            <div id="tabContent-statuses" class="flex-1 flex flex-col overflow-y-auto hidden p-4 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="statusTabTitle">Мой статус</h3>
                    <button onclick="document.getElementById('statusFileInput').click()" class="text-xs text-indigo-400 hover:text-indigo-300 font-semibold flex items-center gap-1 btn-anim">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> <span data-i18n="addStatusBtn">Добавить</span>
                    </button>
                    <input type="file" id="statusFileInput" accept="image/*" class="hidden" onchange="handleAddStatus(event)">
                </div>
                
                <div class="flex items-center space-x-3 p-3 bg-slate-950/40 border border-slate-800/50 rounded-2xl cursor-pointer hover:bg-slate-900/40 transition justify-between" onclick="viewMyStatus()">
                    <div class="flex items-center space-x-3 overflow-hidden flex-1">
                        <div class="relative flex-shrink-0">
                            <img id="myStatusAvatar" src="" class="w-11 h-11 rounded-full object-cover border-2 border-indigo-500 p-0.5 bg-slate-900">
                            <div class="absolute bottom-0 right-0 bg-indigo-600 rounded-full w-4 h-4 flex items-center justify-center text-white text-[10px] border border-slate-900 font-bold">+</div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-bold text-xs text-slate-200" data-i18n="myStatusLabel">Мой статус</h4>
                            <p id="myStatusTime" class="text-[10px] text-slate-400 truncate" data-i18n="noStatusYet">Нажмите, чтобы добавить или просмотреть</p>
                            <p id="myStatusPreviewText" class="text-[11px] text-slate-400 italic truncate mt-0.5 hidden"></p>
                        </div>
                    </div>
                    <div id="myStatusPreviewImgContainer" class="w-10 h-10 rounded-lg overflow-hidden border border-slate-800/80 flex-shrink-0 hidden">
                        <img id="myStatusPreviewImg" src="" class="w-full h-full object-cover">
                    </div>
                </div>

                <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider pt-2" data-i18n="recentStatuses">Недавние обновления</h3>
                <div class="space-y-3" id="recentStatusesContainer">
                    <!-- Заполняется динамически -->
                </div>
            </div>

            <!-- ТАБ: ЗВОНКИ -->
            <div id="tabContent-calls" class="flex-1 flex flex-col overflow-y-auto hidden p-4 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="callTabTitle">Журнал звонков</h3>
                    <button onclick="clearCallHistory()" class="text-xs text-red-400 hover:text-red-300 font-semibold flex items-center gap-1 btn-anim">
                        <i data-lucide="trash-2" class="w-4 h-4"></i> <span data-i18n="clearCallsBtn">Очистить</span>
                    </button>
                </div>
                <div class="space-y-3 animate-fade-in" id="callHistoryContainer">
                    <!-- Заполняется динамически -->
                </div>
            </div>

            <!-- КНОПКА ТЕЛЕФОННЫХ КОНТАКТОВ (ПЛАСТИКОВЫЙ СТИЛЬ) -->
            <button onclick="togglePhoneContactsModal()" class="absolute bottom-4 right-4 w-14 h-14 plastic-btn flex items-center justify-center text-white z-20 btn-anim" id="phoneContactsBtn" data-i18n="phoneContactsTooltip" title="Посмотреть контакты телефона">
                <i data-lucide="contact" class="w-6 h-6"></i>
            </button>
        </aside>

        <!-- ПРАВАЯ ПАНЕЛЬ: ОКНО ЧАТА -->
        <main class="hidden md:flex flex-1 h-full flex-col bg-slate-950/40 relative" id="chatArea">
            <!-- Состояние без выбранного чата -->
            <div id="noChatSelected" class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-slate-950">
                <div class="w-20 h-20 rounded-3xl bg-indigo-500/10 flex items-center justify-center text-indigo-500 mb-4 animate-bounce">
                    <i data-lucide="message-square" class="w-10 h-10"></i>
                </div>
                <h3 class="text-xl font-bold mb-2" data-i18n="welcomeTitle">Добро пожаловать в GzafChat</h3>
                <p class="text-slate-400 text-sm max-w-sm" data-i18n="welcomeDesc">Выберите чат. Кликните по аватарке собеседника или своей, чтобы открыть информацию о профиле.</p>
            </div>

            <!-- Активное окно чата -->
            <div id="activeChat" class="hidden flex-1 flex flex-col h-full overflow-hidden relative">
                <!-- Шапка чата -->
                <div class="p-4 border-b border-slate-800 bg-slate-900/50 flex justify-between items-center flex-shrink-0">
                    <div class="flex items-center space-x-3 overflow-hidden">
                        <button onclick="backToSidebar()" class="md:hidden p-2 text-slate-400 hover:text-white mr-1 flex-shrink-0 btn-anim">
                            <i data-lucide="arrow-left" class="w-5 h-5"></i>
                        </button>
                        <img id="chatAvatar" src="" onclick="openProfileInfo(event, 'contact')" class="w-10 h-10 rounded-full object-cover flex-shrink-0 cursor-pointer hover:opacity-80 transition" alt="Avatar">
                        <div class="overflow-hidden">
                            <h3 id="chatName" class="font-semibold text-sm truncate"></h3>
                            <span id="chatStatus" class="text-xs text-slate-400 block truncate"></span>
                        </div>
                    </div>
                    <div class="flex space-x-2 text-slate-400 flex-shrink-0">
                        <!-- КНОПКА АУДИОЗВОНКА -->
                        <button class="p-2 hover:bg-slate-800 rounded-full transition text-emerald-400 hover:text-emerald-300 btn-anim" onclick="startAudioCall()"><i data-lucide="phone" class="w-5 h-5"></i></button>
                        <!-- КНОПКА ВИДЕОЗВОНКА -->
                        <button class="p-2 hover:bg-slate-800 rounded-full transition text-indigo-400 hover:text-indigo-300 btn-anim" onclick="startVideoCall()"><i data-lucide="video" class="w-5 h-5"></i></button>
                    </div>
                </div>

                <!-- Сообщения -->
                <div class="flex-1 overflow-y-auto p-4 space-y-4" id="messagesContainer">
                    <!-- Сюда рендерятся сообщения -->
                </div>

                <!-- Панель ввода и Смайликов (Относительное позиционирование) -->
                <div class="p-4 bg-slate-900/50 border-t border-slate-800 flex-shrink-0 relative">
                    
                    <!-- ДИНАМИЧЕСКАЯ ПАНЕЛЬ СМАЙЛИКОВ -->
                    <div id="emojiPanel" class="hidden absolute bottom-20 left-4 right-4 sm:left-4 sm:right-auto sm:w-80 bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-4 z-30 max-h-80 overflow-y-auto flex flex-col space-y-4 animate-in slide-in-from-bottom-2 duration-150">
                        <!-- Контент рендерится из JS -->
                    </div>

                    <!-- Поле отправки -->
                    <form id="messageForm" onsubmit="handleSend(event)" class="flex items-center space-x-2">
                        <button type="button" onclick="toggleEmojiPanel()" class="p-2.5 text-slate-400 hover:text-indigo-400 hover:bg-slate-800 rounded-xl transition btn-anim">
                            <i data-lucide="smile" class="w-5 h-5"></i>
                        </button>
                        
                        <!-- Загрузка изображения -->
                        <button type="button" onclick="document.getElementById('fileInput').click()" class="p-2.5 text-slate-400 hover:text-indigo-400 hover:bg-slate-800 rounded-xl transition btn-anim">
                            <i data-lucide="paperclip" class="w-5 h-5"></i>
                        </button>
                        <input type="file" id="fileInput" accept="image/*" class="hidden" onchange="handleImageUpload(event)">

                        <input type="text" id="messageInput" autocomplete="off" placeholder="Напишите сообщение..." class="flex-1 min-w-0 bg-slate-950 border border-slate-800 rounded-xl py-2.5 px-4 text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition">

                        <!-- Микрофон -->
                        <button type="button" id="micBtn" onclick="toggleVoiceRecord()" class="p-2.5 text-slate-400 hover:text-red-400 hover:bg-slate-800 rounded-xl transition flex items-center justify-center btn-anim">
                            <i data-lucide="mic" id="micIcon" class="w-5 h-5"></i>
                            <span id="recordTimer" class="hidden text-xs text-red-500 ml-1 font-mono">0:00</span>
                        </button>

                        <button type="submit" class="p-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl transition shadow-lg flex-shrink-0 btn-anim">
                            <i data-lucide="send" class="w-5 h-5"></i>
                        </button>
                    </form>
                </div>
            </div>
        </main>

    </div>

    <!-- МОДАЛЬНОЕ ОКНО НАСТРОЕК (РАСШИРЕННЫЙ ДВУХКОЛОНОЧНЫЙ ДИЗАЙН) -->
    <div id="settingsModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-3xl flex flex-col max-h-[90vh] shadow-2xl overflow-hidden">
            <!-- Шапка настроек -->
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
                <h3 class="text-base font-bold flex items-center gap-2" data-i18n="settingsTitle">
                    <i data-lucide="settings" class="w-5 h-5 text-indigo-500"></i> Настройки дизайна и профиля
                </h3>
                <button onclick="toggleSettingsModal()" class="p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition btn-anim">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <!-- Содержимое настроек (Двухколоночный Grid) -->
            <div class="p-5 overflow-y-auto space-y-6 flex-1 text-sm">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    
                    <!-- ЛЕВАЯ СЕКЦИЯ: ПРОФИЛЬ И КАСТОМИЗАЦИЯ -->
                    <div class="space-y-6">
                        <!-- Секция: Профиль -->
                        <div class="space-y-4">
                            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="profileSection">Мой Профиль</h4>
                            <div class="flex items-center space-x-4">
                                <div class="relative group cursor-pointer flex-shrink-0 btn-anim" onclick="document.getElementById('profilePicInput').click()">
                                    <img id="settingsProfilePic" src="" class="w-16 h-16 rounded-full object-cover ring-2 ring-indigo-500 hover:opacity-85 transition" alt="My Photo">
                                    <div class="absolute inset-0 bg-black/50 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
                                        <i data-lucide="camera" class="w-5 h-5 text-white"></i>
                                    </div>
                                </div>
                                <input type="file" id="profilePicInput" accept="image/*" class="hidden" onchange="handleProfilePicUpload(event)">
                                
                                <div class="flex-1 space-y-2">
                                    <div>
                                        <label class="block text-[11px] text-slate-400 mb-1" data-i18n="displayNameLabel">Отображаемое имя</label>
                                        <input type="text" id="settingsProfileName" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-1.5 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                    </div>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[11px] text-slate-400 mb-1" data-i18n="bioLabel">О себе (Статус)</label>
                                    <input type="text" id="settingsProfileBio" placeholder="Информация о вас" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] text-slate-400 mb-1" data-i18n="phoneLabel">Номер телефона</label>
                                    <input type="text" id="settingsProfilePhone" placeholder="+7 (000) 000-00-00" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                </div>
                            </div>
                        </div>

                        <!-- Язык и Тема оформления -->
                        <div class="space-y-4 border-t border-slate-800/80 pt-4">
                            <div>
                                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" data-i18n="langLabel">Язык интерфейса</h4>
                                <select id="settingsLang" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                    <option value="ru">Русский</option>
                                    <option value="az">Azərbaycanca</option>
                                    <option value="en">English</option>
                                </select>
                            </div>
                            <div>
                                <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" data-i18n="themeLabel">Тема оформления</h4>
                                <select id="settingsTheme" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                    <option value="dark" data-i18n="themeDark">Тёмная</option>
                                    <option value="light" data-i18n="themeLight">Светлая</option>
                                </select>
                            </div>
                        </div>

                        <!-- Секция: Дизайн и темы -->
                        <div class="space-y-4 border-t border-slate-800/80 pt-4">
                            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider" data-i18n="designSection">Кастомизация дизайна чата</h4>
                            
                            <div class="space-y-3">
                                <!-- Фон чата -->
                                <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-xl border border-slate-800">
                                    <span class="text-xs text-slate-300" data-i18n="chatBgLabel">Фон переписки (Задний план)</span>
                                    <input type="color" id="settingsBgColor" class="w-10 h-7 rounded border-0 bg-transparent cursor-pointer">
                                </div>

                                <!-- Мои сообщения -->
                                <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800 space-y-2">
                                    <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider block" data-i18n="myBubbleLabel">Мои сообщения (Справа)</span>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div class="flex items-center justify-between bg-slate-900 p-2 rounded-lg">
                                            <span class="text-[11px] text-slate-400" data-i18n="bubbleColorLabel">Пузырь</span>
                                            <input type="color" id="settingsMyBubbleColor" class="w-8 h-6 rounded border-0 bg-transparent cursor-pointer">
                                        </div>
                                        <div class="flex items-center justify-between bg-slate-900 p-2 rounded-lg">
                                            <span class="text-[11px] text-slate-400" data-i18n="textColorLabel">Текст</span>
                                            <input type="color" id="settingsMyTextColor" class="w-8 h-6 rounded border-0 bg-transparent cursor-pointer">
                                        </div>
                                    </div>
                                </div>

                                <!-- Чужие сообщения -->
                                <div class="bg-slate-950/40 p-3 rounded-xl border border-slate-800 space-y-2">
                                    <span class="text-[11px] text-slate-400 font-bold uppercase tracking-wider block" data-i18n="theirBubbleLabel">Чужие сообщения (Слева)</span>
                                    <div class="grid grid-cols-2 gap-2">
                                        <div class="flex items-center justify-between bg-slate-900 p-2 rounded-lg">
                                            <span class="text-[11px] text-slate-400" data-i18n="bubbleColorLabel">Пузырь</span>
                                            <input type="color" id="settingsTheirBubbleColor" class="w-8 h-6 rounded border-0 bg-transparent cursor-pointer">
                                        </div>
                                        <div class="flex items-center justify-between bg-slate-900 p-2 rounded-lg">
                                            <span class="text-[11px] text-slate-400" data-i18n="textColorLabel">Текст</span>
                                            <input type="color" id="settingsTheirTextColor" class="w-8 h-6 rounded border-0 bg-transparent cursor-pointer">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ПРАВАЯ СЕКЦИЯ: ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ПРОЕКТА -->
                    <div class="space-y-6 border-t md:border-t-0 md:border-l border-slate-800 pt-6 md:pt-0 md:pl-6">
                        <div class="flex items-center gap-2 pb-2 border-b border-slate-800/60">
                            <i data-lucide="shield-check" class="w-5 h-5 text-indigo-400"></i>
                            <h4 class="text-xs font-bold text-slate-300 uppercase tracking-wider" data-i18n="extraSettingsTitle">Дополнительные настройки</h4>
                        </div>

                        <!-- Конфиденциальность -->
                        <div class="space-y-3">
                            <span class="text-[11px] text-slate-500 font-bold uppercase tracking-wider block" data-i18n="privacyLabel">Конфиденциальность</span>
                            
                            <div>
                                <label class="block text-[11px] text-slate-400 mb-1" data-i18n="privacyLastSeenLabel">Показывать статус "был в сети"</label>
                                <select id="settingsPrivacyLastSeen" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                    <option value="everyone" data-i18n="privacyLastSeenEveryone">Всем</option>
                                    <option value="contacts" data-i18n="privacyLastSeenContacts">Моим контактам</option>
                                    <option value="nobody" data-i18n="privacyLastSeenNobody">Никому</option>
                                </select>
                            </div>

                            <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-xl border border-slate-800">
                                <div class="flex flex-col">
                                    <span class="text-xs text-slate-300" data-i18n="typingDelayLabel">Симуляция печатания</span>
                                    <span class="text-[10px] text-slate-500" data-i18n="typingDelayDesc">Эмулировать "Печатает..." перед ответом бота</span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="settingsTypingDelay" class="sr-only peer">
                                    <div class="w-9 h-5 bg-slate-850 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 peer-checked:after:bg-white peer-checked:after:border-transparent"></div>
                                </label>
                            </div>
                        </div>

                        <!-- Звуки и оповещения -->
                        <div class="space-y-3">
                            <span class="text-[11px] text-slate-500 font-bold uppercase tracking-wider block" data-i18n="soundSection">Звук и уведомления</span>
                            
                            <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-xl border border-slate-800">
                                <div class="flex flex-col">
                                    <span class="text-xs text-slate-300" data-i18n="soundEffectsLabel">Звуковые эффекты</span>
                                    <span class="text-[10px] text-slate-500" data-i18n="soundEffectsDesc">Проигрывать при отправке и получении</span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="settingsSoundEffects" class="sr-only peer">
                                    <div class="w-9 h-5 bg-slate-850 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 peer-checked:after:bg-white peer-checked:after:border-transparent"></div>
                                </label>
                            </div>
                        </div>

                        <!-- Юзабилити и поведение чата -->
                        <div class="space-y-3">
                            <span class="text-[11px] text-slate-500 font-bold uppercase tracking-wider block" data-i18n="behaviorLabel">Поведение чата</span>
                            
                            <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-xl border border-slate-800">
                                <div class="flex flex-col">
                                    <span class="text-xs text-slate-300" data-i18n="enterSendLabel">Отправка клавишей Enter</span>
                                    <span class="text-[10px] text-slate-500" data-i18n="enterSendDesc">Отправлять текст без Shift</span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="settingsEnterSend" class="sr-only peer">
                                    <div class="w-9 h-5 bg-slate-850 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 peer-checked:after:bg-white peer-checked:after:border-transparent"></div>
                                </label>
                            </div>

                            <div class="flex items-center justify-between bg-slate-950/40 p-2.5 rounded-xl border border-slate-800">
                                <div class="flex flex-col">
                                    <span class="text-xs text-slate-300" data-i18n="compactModeLabel">Компактный вид</span>
                                    <span class="text-[10px] text-slate-500" data-i18n="compactModeDesc">Уменьшить отступы пузырей переписки</span>
                                </div>
                                <label class="relative inline-flex items-center cursor-pointer">
                                    <input type="checkbox" id="settingsCompactMode" class="sr-only peer">
                                    <div class="w-9 h-5 bg-slate-850 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-400 after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-indigo-600 peer-checked:after:bg-white peer-checked:after:border-transparent"></div>
                                </label>
                            </div>

                            <div>
                                <label class="block text-[11px] text-slate-400 mb-1" data-i18n="disappearingMsgsLabel">Исчезающие сообщения</label>
                                <select id="settingsDisappearing" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-slate-200 focus:outline-none focus:border-indigo-500 transition text-xs">
                                    <option value="off" data-i18n="disappearingOff">Выключены</option>
                                    <option value="24h" data-i18n="disappearing24h">24 часа</option>
                                    <option value="7d" data-i18n="disappearing7d">7 дней</option>
                                    <option value="90d" data-i18n="disappearing90d">90 дней</option>
                                </select>
                            </div>
                        </div>

                        <!-- Секция: Сброс данных -->
                        <div class="space-y-3 border-t border-slate-800/80 pt-4">
                            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider text-red-500" data-i18n="systemSection">Системные настройки</h4>
                            <div class="grid grid-cols-2 gap-2">
                                <button type="button" onclick="handleLogout()" class="w-full py-2 px-4 bg-red-600/10 hover:bg-red-600 text-red-400 hover:text-white rounded-xl border border-red-500/20 hover:border-transparent transition text-center font-medium btn-anim text-xs" data-i18n="logoutBtn">
                                    Выйти из аккаунта
                                </button>
                                <button type="button" onclick="resetApp()" class="w-full py-2 px-4 bg-red-600/10 hover:bg-red-600 text-red-400 hover:text-white rounded-xl border border-red-500/20 hover:border-transparent transition text-center font-medium btn-anim text-xs" data-i18n="resetBtn">
                                    Сбросить базу
                                </button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Кнопки внизу -->
            <div class="p-4 border-t border-slate-800 flex justify-end space-x-2 bg-slate-950/50">
                <button onclick="toggleSettingsModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-750 text-slate-300 rounded-xl transition text-xs btn-anim" data-i18n="cancelBtn">Отмена</button>
                <button onclick="saveSettings()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl shadow-lg transition text-xs font-semibold btn-anim" data-i18n="saveBtn">Сохранить</button>
            </div>
        </div>
    </div>

    <!-- МОДАЛЬНОЕ ОКНО: ИНФОРМАЦИЯ О ПРОФИЛЕ -->
    <div id="profileInfoModal" class="hidden fixed inset-0 bg-black/85 backdrop-blur-sm z-[60] flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-sm flex flex-col shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Шапка инфо -->
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
                <h3 class="text-sm font-bold flex items-center gap-2">
                    <i data-lucide="user" class="w-4 h-4 text-indigo-500"></i> <span data-i18n="appName">GzafChat</span>
                </h3>
                <button onclick="toggleProfileInfoModal()" class="p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition btn-anim">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            
            <!-- Карточка пользователя -->
            <div class="p-6 flex flex-col items-center text-center space-y-4">
                <!-- Контейнер аватары с интерактивным изменением наведения -->
                <div class="relative group cursor-pointer flex-shrink-0 btn-anim" id="infoModalAvatarContainer">
                    <img id="infoModalAvatar" src="" class="w-24 h-24 rounded-full object-cover ring-4 ring-indigo-500/30 shadow-xl" alt="Avatar">
                    <div id="infoModalAvatarHover" class="absolute inset-0 bg-black/50 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition">
                        <i data-lucide="camera" class="w-6 h-6 text-white animate-pulse"></i>
                    </div>
                </div>
                
                <div>
                    <h4 id="infoModalName" class="text-lg font-bold text-slate-100"></h4>
                    <p id="infoModalStatus" class="text-xs text-indigo-400 mt-1"></p>
                </div>

                <!-- Детальные поля -->
                <div class="w-full border-t border-slate-800/80 pt-4 text-left space-y-3.5 text-xs">
                    <div>
                        <span class="text-slate-500 block uppercase tracking-wider font-bold text-[9px]" data-i18n="regBioLabel">О себе</span>
                        <p id="infoModalBio" class="text-slate-300 mt-0.5 leading-relaxed"></p>
                    </div>
                    <div>
                        <span class="text-slate-500 block uppercase tracking-wider font-bold text-[9px]" data-i18n="phoneLabel">Номер телефона</span>
                        <p id="infoModalPhone" class="text-slate-300 mt-0.5 font-mono"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- МОДАЛЬНОЕ ОКНО СОЗДАНИЯ ГРУППЫ -->
    <div id="groupModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md flex flex-col max-h-[90vh] shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Шапка модалки -->
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
                <h3 class="text-base font-bold flex items-center gap-2" data-i18n="createGroupTitle">
                    <i data-lucide="users" class="w-5 h-5 text-indigo-500"></i> Создать группу
                </h3>
                <button onclick="toggleGroupModal()" class="p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition btn-anim">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <!-- Контент -->
            <div class="p-5 overflow-y-auto space-y-4 flex-1 text-sm">
                <div>
                    <label class="block text-[11px] text-slate-400 mb-1 font-semibold uppercase" data-i18n="groupNameLabel">Название группы</label>
                    <input type="text" id="groupNameInput" required placeholder="например, Команда проекта" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2.5 px-4 text-sm text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                
                <div>
                    <label class="block text-[11px] text-slate-400 mb-2 font-semibold uppercase" data-i18n="chooseMembersLabel">Выберите участников</label>
                    <div id="groupMembersList" class="space-y-2 max-h-48 overflow-y-auto bg-slate-950/50 p-3 rounded-xl border border-slate-800/60">
                        <!-- Заполняется динамически списком контактов -->
                    </div>
                </div>
            </div>

            <!-- Кнопки управления -->
            <div class="p-4 border-t border-slate-800 flex justify-end space-x-2 bg-slate-950/50">
                <button onclick="toggleGroupModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-750 text-slate-300 rounded-xl transition text-xs btn-anim" data-i18n="cancelBtn">Отмена</button>
                <button onclick="createGroup()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl shadow-lg transition text-xs font-semibold btn-anim" data-i18n="createGroupBtn">Создать</button>
            </div>
        </div>
    </div>

    <!-- МОДАЛЬНОЕ ОКНО ТЕЛЕФОННЫХ КОНТАКТОВ -->
    <div id="phoneContactsModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-md flex flex-col max-h-[80vh] shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Шапка -->
            <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
                <h3 class="text-base font-bold flex items-center gap-2" data-i18n="phoneContactsTitle">
                    <i data-lucide="contact" class="w-5 h-5 text-indigo-500"></i> Контакты на телефоне
                </h3>
                <button onclick="togglePhoneContactsModal()" class="p-1.5 hover:bg-slate-800 rounded-lg text-slate-400 hover:text-white transition btn-anim">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <!-- Импорт контактов (.vcf) -->
            <div class="p-4 border-b border-slate-800/60 bg-slate-950/20 space-y-2 text-xs">
                <label class="block text-[11px] text-slate-400 font-semibold uppercase">Импорт контактов (.vcf)</label>
                <input type="file" id="vcfFileInput" accept=".vcf" onchange="handleVCFImport(event)" class="block w-full text-xs text-slate-400 file:mr-4 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-600/20 file:text-indigo-400 hover:file:bg-indigo-600/30 cursor-pointer">
            </div>

            <!-- Добавление кастомного контакта вручную -->
            <div class="p-4 border-b border-slate-800/60 bg-slate-950/10 space-y-3 text-xs">
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" id="manualContactName" placeholder="Имя" class="bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                    <input type="text" id="manualContactPhone" placeholder="+7 (999) 000-00-00" class="bg-slate-950 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <button onclick="addManualContact()" class="w-full py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-[11px] font-bold rounded-lg transition btn-anim uppercase tracking-wider" data-i18n="addManualContact">Добавить контакт</button>
            </div>

            <!-- Список контактов -->
            <div class="p-4 overflow-y-auto space-y-3 flex-1 text-sm bg-slate-950/20" id="phoneContactsList">
                <!-- Заполняется динамически из JS -->
            </div>
            
            <!-- Подвал -->
            <div class="p-4 border-t border-slate-800 flex justify-end bg-slate-950/50">
                <button onclick="togglePhoneContactsModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-750 text-slate-300 rounded-xl transition text-xs btn-anim" data-i18n="cancelBtn">Отмена</button>
            </div>
        </div>
    </div>

    <!-- ИНТЕРФЕЙС АУДИОЗВОНКА (СТАТИЧЕСКИЙ ОВЕРЛЕЙ) -->
    <div id="callOverlay" class="hidden fixed inset-0 bg-slate-950/95 backdrop-blur-md z-[250] flex flex-col items-center justify-between p-8 text-center animate-in fade-in duration-200">
        <div class="flex items-center gap-2 text-xs text-slate-500 bg-slate-900 border border-slate-800 px-4 py-1.5 rounded-full mt-4">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-emerald-500"></i>
            <span data-i18n="encryptedLabel">Зашифровано</span>
        </div>

        <div class="flex flex-col items-center space-y-6">
            <div class="relative flex items-center justify-center">
                <div id="callPulseRing" class="absolute w-36 h-36 bg-indigo-500/10 rounded-full"></div>
                <img id="callContactAvatar" src="" class="w-28 h-28 rounded-full object-cover ring-4 ring-indigo-500/40 relative z-10 shadow-2xl" alt="Call Avatar">
            </div>
            <div>
                <h2 id="callContactName" class="text-2xl font-bold tracking-wide">Собеседник</h2>
                <p id="callState" class="text-sm text-indigo-400 font-medium tracking-wider mt-2">Инициализация...</p>
            </div>
        </div>

        <div class="flex space-x-6 mb-8">
            <button id="callMuteBtn" onclick="toggleCallMute()" class="w-14 h-14 bg-slate-800 hover:bg-slate-750 text-white rounded-full flex items-center justify-center transition btn-anim shadow-lg">
                <i data-lucide="mic-off" class="w-5 h-5"></i>
            </button>
            <button onclick="endAudioCall()" class="w-16 h-16 bg-red-600 hover:bg-red-500 text-white rounded-full flex items-center justify-center transition btn-anim shadow-xl transform hover:rotate-90">
                <i data-lucide="phone-off" class="w-6 h-6"></i>
            </button>
            <button id="callSpeakerBtn" onclick="toggleCallSpeaker()" class="w-14 h-14 bg-slate-800 hover:bg-slate-750 text-white rounded-full flex items-center justify-center transition btn-anim shadow-lg">
                <i data-lucide="volume-2" class="w-5 h-5"></i>
            </button>
        </div>
    </div>

    <!-- ИНТЕРФЕЙС ВИДЕОЗВОНКА (СТАТИЧЕСКИЙ ОВЕРЛЕЙ) -->
    <div id="videoCallOverlay" class="hidden fixed inset-0 bg-slate-950 z-[250] flex flex-col justify-between animate-in fade-in duration-200 overflow-hidden">
        
        <!-- Верхняя информационная плашка -->
        <div class="absolute top-4 left-4 right-4 z-30 flex justify-between items-center bg-black/40 backdrop-blur-md p-4 rounded-2xl border border-white/5">
            <div class="flex items-center space-x-3">
                <div class="overflow-hidden">
                    <h3 id="videoCallContactName" class="font-bold text-sm text-white truncate"></h3>
                    <p id="videoCallState" class="text-xs text-indigo-400 font-medium mt-0.5 tracking-wider">Подключение...</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5 text-[10px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full font-semibold uppercase tracking-wider">
                <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> <span data-i18n="encryptedLabel">Зашифровано</span>
            </div>
        </div>

        <!-- Центральный видеоконтент (Удаленный абонент на весь экран) -->
        <div class="flex-1 w-full h-full relative bg-slate-950 flex items-center justify-center">
            
            <!-- Состояние вызова (до ответа собеседника) -->
            <div id="videoCallRemoteCalling" class="flex flex-col items-center space-y-4 z-20">
                <img id="videoCallRemoteAvatar" src="" class="w-24 h-24 rounded-full object-cover ring-4 ring-indigo-500/30 animate-pulse">
                <p class="text-xs text-slate-400" data-i18n="videoCallRemoteCalling">Ожидание ответа удаленного терминала...</p>
            </div>

            <!-- Имитация видеопотока удаленного пользователя после ответа -->
            <div id="videoCallRemotePlaceholder" class="hidden absolute inset-0 w-full h-full flex items-center justify-center bg-gradient-to-tr from-slate-950 via-indigo-950/20 to-slate-900">
                <div class="absolute text-center opacity-25">
                    <i data-lucide="video" class="w-20 h-20 mx-auto text-indigo-400 animate-pulse mb-2"></i>
                    <p class="text-xs tracking-widest uppercase font-bold text-slate-400">Secure Remote Feed</p>
                </div>
            </div>

            <!-- МИНИ-ОКНО: ЛОКАЛЬНЫЙ ПОЛЬЗОВАТЕЛЬ (КАМЕРА С КОРРЕКТНЫМ ПЕРЕКРЫТИЕМ) -->
            <div class="absolute bottom-28 right-4 w-28 h-40 sm:w-36 sm:h-48 rounded-2xl border border-white/10 shadow-2xl overflow-hidden z-20 bg-slate-900 flex items-center justify-center">
                <!-- Реальный тег для вывода видео с камеры смартфона/ноутбука -->
                <video id="localVideo" autoplay playsinline muted class="hidden w-full h-full object-cover transform -scale-x-100"></video>
                
                <!-- Анимированная SVG симуляция если нет камеры -->
                <div id="localVideoSimulated" class="hidden w-full h-full bg-gradient-to-b from-indigo-600/30 to-slate-950 relative flex items-center justify-center">
                    <span class="absolute top-2 left-2 text-[8px] font-mono bg-indigo-600 text-white px-1.5 py-0.5 rounded uppercase tracking-wider animate-pulse">SIM FEEED</span>
                    <i data-lucide="user" class="w-8 h-8 text-indigo-400 animate-bounce"></i>
                </div>

                <!-- Заглушка если камера выключена пользователем -->
                <div id="localVideoPlaceholder" class="hidden w-full h-full bg-slate-950 flex flex-col items-center justify-center text-center p-2 text-red-400">
                    <i data-lucide="video-off" class="w-5 h-5"></i>
                </div>
            </div>

        </div>

        <!-- Нижняя панель управления звонком -->
        <div class="absolute bottom-6 left-0 right-0 z-30 flex justify-center items-center space-x-5 px-4">
            <button id="videoCallMuteBtn" onclick="toggleCallMute()" class="w-12 h-12 bg-slate-900/80 hover:bg-slate-800 text-white border border-white/5 rounded-full flex items-center justify-center transition btn-anim shadow-lg">
                <i data-lucide="mic-off" class="w-5 h-5"></i>
            </button>
            <button onclick="endVideoCall()" class="w-14 h-14 bg-red-600 hover:bg-red-500 text-white rounded-full flex items-center justify-center transition btn-anim shadow-xl transform hover:rotate-90">
                <i data-lucide="phone-off" class="w-5 h-5"></i>
            </button>
            <button id="videoCallCameraBtn" onclick="toggleVideoCallCamera()" class="w-12 h-12 bg-indigo-600 hover:bg-indigo-500 text-white border border-white/5 rounded-full flex items-center justify-center transition btn-anim shadow-lg">
                <i data-lucide="video" class="w-5 h-5"></i>
            </button>
        </div>

    </div>

    <!-- ОВЕРЛЕЙ ДЛЯ ПОЛНОЭКРАННОГО ПРОСМОТРА СТАТУСОВ -->
    <div id="statusViewerOverlay" class="hidden fixed inset-0 bg-black z-[300] flex flex-col justify-between p-4 animate-in fade-in duration-200" onclick="closeStatusViewer()">
        <!-- Индикатор прогресса -->
        <div class="w-full flex space-x-1 px-2 mt-2">
            <div class="h-1 bg-white/20 rounded-full flex-1 overflow-hidden">
                <div id="statusProgressBar" class="h-full bg-indigo-500 w-0"></div>
            </div>
        </div>
        <!-- Шапка -->
        <div class="flex justify-between items-center px-2 text-white">
            <div class="flex items-center space-x-3">
                <img id="statusViewerAvatar" src="" class="w-10 h-10 rounded-full object-cover border border-white/20">
                <div>
                    <h4 id="statusViewerName" class="font-bold text-sm"></h4>
                    <p id="statusViewerTime" class="text-xs text-slate-400"></p>
                </div>
            </div>
            <button class="p-2 text-white/80 hover:text-white transition" onclick="closeStatusViewer()"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <!-- Контент -->
        <div class="flex-1 flex flex-col items-center justify-center p-4">
            <img id="statusViewerImage" src="" class="max-w-full max-h-[70vh] rounded-2xl object-contain shadow-2xl">
            <p id="statusViewerText" class="text-white text-base font-semibold mt-4 text-center px-4 max-w-md drop-shadow"></p>
        </div>
    </div>


    <!-- СКРИПТ ПРИЛОЖЕНИЯ -->
    <script>
        // Демо-пользователи в базе данных по умолчанию
        const initialUsers = [
            {
                username: "admin",
                password: "admin",
                displayName: "Константин (Админ)",
                avatar: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150",
                bio: "Разработчик GzafChat. Люблю экспериментировать с кодом и улучшать дизайн! ☕💻",
                phone: "+7 (999) 777-77-77"
            }
        ];

        // Первоначальный список телефонных контактов пустой, чтобы не показывать случайных незнакомцев
        let mockPhoneContacts = [];

        // Стандартные контакты по умолчанию
        const defaultChats = [
            {
                id: 1,
                name: "Алиса Дизайнер",
                avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150",
                status: "в сети",
                bio: "Проектирую удобные интерфейсы. Люблю минимализм и темные оттенки. Всегда открыта к предложениям! 🎨✨",
                phone: "+7 (921) 555-43-21",
                messages: [
                    { id: 1, text: "Привет! Как тебе новый макет мессенджера?", sender: 'them', type: 'text', timestamp: '14:20' },
                    { id: 2, text: "Выглядит потрясающе! Мне нравится цветовая гамма.", sender: 'me', type: 'text', timestamp: '14:22' },
                    { id: 3, text: "Отлично, сегодня закончу остальные экраны и пришлю.", sender: 'them', type: 'text', timestamp: '14:23' }
                ],
                unread: 0,
                botReplies: [
                    "Давай сделаем кнопку отправки чуть ярче?",
                    "Я отправлю тебе фигму через час.",
                    "Как тебе идея добавить темную тему по умолчанию?",
                    "Супер! Рада, что тебе нравится 👍"
                ]
            },
            {
                id: 2,
                name: "Боб Разработчик",
                avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150",
                status: "был(а) недавно",
                bio: "Фуллстек-разработчик. Автоматизирую всё, что движется. Люблю писать код под приятный лоу-фай 💻☕",
                phone: "+7 (911) 444-12-34",
                messages: [
                    { id: 1, text: "Привет, API для отправки файлов готово. Можешь проверять.", sender: 'them', type: 'text', timestamp: '11:05' }
                ],
                unread: 1,
                botReplies: [
                    "Да, код уже в ветке main. Можешь стянуть.",
                    "Я пофиксил баг с прокруткой сообщений на мобилках.",
                    "Завтра начну настраивать базу данных.",
                    "Давай созвонимся позже, обсудим API."
                ]
            }
        ];

        // Статические мок-статусы от контактов
        const mockStatuses = [
            {
                id: 101,
                name: "Алиса Дизайнер",
                avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150",
                media: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?w=500",
                text: "Работаю над новым интерфейсом GzafChat v2! 🎨✨",
                time: "15 минут назад"
            },
            {
                id: 102,
                name: "Боб Разработчик",
                avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150",
                media: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=500",
                text: "Пофиксил все баги, можно пить кофе ☕💻",
                time: "2 часа назад"
            }
        ];

        // Стандартные настройки профиля с дефолтными HEX-цветами (используются при создании новой сессии)
